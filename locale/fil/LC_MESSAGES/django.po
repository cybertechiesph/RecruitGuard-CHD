msgstr "I-email sa akin ang code"

#: recruitment/templates/recruitment/applicant_otp.html
msgid "Wrong email address?"
msgstr "Mali ang email address?"

#: recruitment/templates/recruitment/applicant_otp.html
msgid "Start again with the correct email"
msgstr "Magsimula ulit gamit ang tamang email"

#: recruitment/templates/recruitment/applicant_otp.html
msgid "Return to job openings"
msgstr "Bumalik sa mga bakanteng trabaho"

#: recruitment/templates/recruitment/applicant_otp.html recruitment/forms.py
msgid "Enter the 6-digit code from your email."
msgstr "Ilagay ang 6-digit na code mula sa iyong email."

#: recruitment/templates/recruitment/applicant_otp.html
msgid "The code is 6 digits — letters or extra characters won’t work."
msgstr "6 na numero ang code — hindi gagana ang mga letra o sobrang character."

#: recruitment/templates/recruitment/applicant_otp.html
msgid "(available in {seconds}s)"
msgstr "(puwede na sa loob ng {seconds}s)"

