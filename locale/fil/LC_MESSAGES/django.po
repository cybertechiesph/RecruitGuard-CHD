#: recruitment/services.py
msgid "You already asked to withdraw this application. The office will confirm by email."
msgstr "Nakapag-request ka na ng withdrawal para sa application na ito. Ico-confirm ito ng office sa email."

#: recruitment/services.py
msgid "This application can no longer be withdrawn online. Please contact the recruitment office."
msgstr "Hindi na puwedeng i-withdraw online ang application na ito. Paki-contact ang recruitment office."

#: recruitment/services.py
msgid "This application was already submitted, so it can no longer be verified."
msgstr "Na-submit na ang application na ito, kaya hindi na ito kailangang i-verify."

#: recruitment/services.py
msgid "Request a verification code first."
msgstr "Humingi muna ng verification code."

#: recruitment/services.py
msgid "The verification code has expired. Request a new code."
msgstr "Nag-expire na ang verification code. Humingi ng bagong code."

#: recruitment/services.py
msgid "The selected recruitment entry is not currently open for intake."
msgstr "Hindi na tumatanggap ng applicants ang position na ito."

#: recruitment/services.py
msgid "This application can no longer be submitted."
msgstr "Hindi na puwedeng i-submit ang application na ito."

#: recruitment/services.py
msgid "Tick the confirmation box before you submit."
msgstr "I-check muna ang confirmation box bago mag-submit."

#: recruitment/services.py
msgid "Some documents use the same file. Use a different file for each document, then submit."
msgstr "May documents na pareho ang file. Gumamit ng ibang file sa bawat document, tapos i-submit."

#: recruitment/services.py
msgid "Only the applicant may resubmit documents for this application."
msgstr "Ang applicant lang ang puwedeng mag-resubmit ng documents para sa application na ito."

#: recruitment/services.py
msgid "This application is not awaiting a document resubmission."
msgstr "Walang hinihintay na documents para sa application na ito."

#: recruitment/services.py
msgid "There are no documents awaiting resubmission."
msgstr "Walang documents na kailangang i-resubmit."

#: recruitment/services.py
msgid "The resubmission deadline has passed; please contact the recruitment team."
msgstr "Lumampas na ang deadline ng resubmission; paki-contact ang recruitment team."

#: recruitment/services.py
msgid "Verify your email with a fresh code before resubmitting your documents."
msgstr "I-verify muna ang email mo gamit ang bagong code bago i-resubmit ang documents mo."

#: recruitment/services.py
msgid "Upload a file for each flagged document before resubmitting."
msgstr "Mag-upload ng file sa bawat document na ibinalik bago mag-resubmit."

#: recruitment/services.py
msgid "Your application draft and uploaded files were saved, but we could not send the verification code right now. Please try again in a few moments."
msgstr "Na-save ang draft at files mo, pero hindi namin maipadala ang verification code ngayon. Subukan ulit maya-maya."

#: recruitment/services.py
msgid "A verification code can only be issued while the application is in draft or awaiting the applicant's resubmission."
msgstr "Puwede lang magpadala ng verification code habang draft pa ang application o habang hinihintay ang resubmission ng applicant."

#: recruitment/services.py
msgid "This application has not been submitted yet."
msgstr "Hindi pa na-submit ang application na ito."

#: recruitment/services.py
msgid "The verification code is invalid. You have %(count)s try left."
msgid_plural "The verification code is invalid. You have %(count)s tries left."
msgstr[0] "Mali ang verification code. %(count)s try na lang ang natitira."
msgstr[1] "Mali ang verification code. %(count)s tries na lang ang natitira."

#: recruitment/services.py
msgid "An application for this recruitment entry already exists for this applicant."
msgstr "May application na ang applicant na ito para sa recruitment na ito."

#: recruitment/services.py
msgid "Add all required documents before you submit. %(count)s required document is still missing."
msgid_plural "Add all required documents before you submit. %(count)s required documents are still missing."
msgstr[0] "I-upload muna lahat ng required documents bago mag-submit. %(count)s required document pa ang kulang."
msgstr[1] "I-upload muna lahat ng required documents bago mag-submit. %(count)s required documents pa ang kulang."

#: recruitment/services.py
msgid "Verify your email before you submit."
msgstr "I-verify muna ang email mo bago mag-submit."

#: recruitment/services.py
msgid "Please wait %(seconds)s seconds before requesting another code."
msgstr "Maghintay ng %(seconds)s segundo bago humingi ulit ng code."

#: recruitment/services.py
msgid "Your email verification has expired. Request a new code, then submit."
msgstr "Nag-expire na ang verification ng email mo. Humingi ng bagong code, tapos i-submit."

#: recruitment/upload_validation.py
msgid "This file is too large. Choose a file that is 5 MB or smaller."
msgstr "Masyadong malaki ang file na ito. Pumili ng file na 5 MB o mas maliit."

#: recruitment/upload_validation.py
msgid "This file is empty. Pick a file that has something in it."
msgstr "Walang laman ang file na ito. Pumili ng file na may laman."

#: recruitment/upload_validation.py
msgid "This needs to be a PDF, JPG, or PNG file. Upload one of those."
msgstr "Dapat PDF, JPG, o PNG ang file. Mag-upload ng isa sa mga iyan."

#: recruitment/upload_validation.py
msgid "We couldn't read this as a PDF, JPG, or PNG. Save it again, then upload it."
msgstr "Hindi namin mabasa ito bilang PDF, JPG, o PNG. I-save ulit, tapos i-upload."

#: recruitment/upload_validation.py
msgid "This file's contents don't match a PDF, JPG, or PNG. Save it again, then upload it."
msgstr "Hindi tugma ang laman ng file na ito sa PDF, JPG, o PNG. I-save ulit, tapos i-upload."

#: recruitment/upload_validation.py
msgid "This file format does not match its filename. Save it again as a PDF, JPG, or PNG, then upload it."
msgstr "Hindi tugma ang format ng file na ito sa pangalan nito. I-save ulit bilang PDF, JPG, o PNG, tapos i-upload."
