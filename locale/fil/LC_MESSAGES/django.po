msgid_plural "We sent a verification code to <strong>%(email)s</strong>. Enter it below to view your application status. The code is valid for %(minutes)s minutes."
msgstr[0] "Nagpadala kami ng verification code sa <strong>%(email)s</strong>. Ilagay ito sa ibaba para makita ang status ng iyong aplikasyon. Gumagana ang code nang %(minutes)s minuto."
msgstr[1] "Nagpadala kami ng verification code sa <strong>%(email)s</strong>. Ilagay ito sa ibaba para makita ang status ng iyong aplikasyon. Gumagana ang code nang %(minutes)s minuto."

