#: recruitment/templates/recruitment/applicant_receipt.html
msgid "Your application will be reviewed by our recruitment team."
msgstr "Rerepasuhin ng aming recruitment team ang iyong aplikasyon."

#: recruitment/templates/recruitment/applicant_receipt.html
msgid "You may be contacted at your email or phone number for updates or additional requirements."
msgstr "Maaari ka naming kontakin sa iyong email o numero ng telepono para sa mga update o karagdagang requirement."

#: recruitment/templates/recruitment/applicant_receipt.html
msgid "You can check your application status anytime using your Tracking Code."
msgstr "Puwede mong alamin ang status ng iyong aplikasyon anumang oras gamit ang iyong Tracking Code."

#: recruitment/templates/recruitment/applicant_receipt.html
msgid "Save your Tracking Code and keep it private."
msgstr "I-save ang iyong Tracking Code at huwag itong ibahagi."

#: recruitment/templates/recruitment/applicant_receipt.html
msgid "You will need it to check your application status online."
msgstr "Kakailanganin mo ito para malaman ang status ng iyong aplikasyon online."

#: recruitment/templates/recruitment/applicant_receipt.html
msgid "A confirmation has also been sent to <strong>%(email)s</strong>."
msgstr "Nagpadala rin kami ng kumpirmasyon sa <strong>%(email)s</strong>."

