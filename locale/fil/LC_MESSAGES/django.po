#: recruitment/templates/recruitment/applicant_otp.html
msgid "Verify your email"
msgstr "I-verify ang iyong email"

#: recruitment/templates/recruitment/applicant_otp.html
msgid "Enter the code we emailed you to continue your application. Anything you already added is saved."
msgstr "Ilagay ang code na in-email namin sa iyo para maituloy ang iyong aplikasyon. Naka-save ang anumang naidagdag mo na."

#: recruitment/templates/recruitment/applicant_otp.html
msgid "To open your saved application, get a new code below &mdash; we&rsquo;ll send it to your email."
msgstr "Para mabuksan ang naka-save mong aplikasyon, humingi ng bagong code sa ibaba &mdash; ipapadala namin ito sa iyong email."

#: recruitment/templates/recruitment/applicant_otp.html
msgid "We sent a 6-digit code to:"
msgstr "Nagpadala kami ng 6-digit na code sa:"

#: recruitment/templates/recruitment/applicant_otp.html
msgid "Your email:"
msgstr "Ang iyong email:"

#: recruitment/templates/recruitment/applicant_otp.html
msgid "Enter the 6-digit code"
msgstr "Ilagay ang 6-digit na code"

#: recruitment/templates/recruitment/applicant_otp.html
msgid "Each code works for %(minutes)s minute. If it expires, get a new one below."
msgid_plural "Each code works for %(minutes)s minutes. If it expires, get a new one below."
msgstr[0] "Gumagana ang bawat code nang %(minutes)s minuto. Kung mag-expire ito, humingi ng bago sa ibaba."
msgstr[1] "Gumagana ang bawat code nang %(minutes)s minuto. Kung mag-expire ito, humingi ng bago sa ibaba."

#: recruitment/templates/recruitment/applicant_otp.html
msgid "Verify and continue"
msgstr "I-verify at magpatuloy"

#: recruitment/templates/recruitment/applicant_otp.html
msgid "Didn&rsquo;t receive the code?"
msgstr "Hindi natanggap ang code?"

#: recruitment/templates/recruitment/applicant_otp.html
msgid "Need a code?"
msgstr "Kailangan ng code?"

#: recruitment/templates/recruitment/applicant_otp.html
msgid "Check your <strong>Spam</strong> or <strong>Junk Mail</strong> folder."
msgstr "Tingnan ang iyong <strong>Spam</strong> o <strong>Junk Mail</strong> folder."

#: recruitment/templates/recruitment/applicant_otp.html
msgid "Make sure the email address above is correct."
msgstr "Siguraduhing tama ang email address sa itaas."

#: recruitment/templates/recruitment/applicant_otp.html
msgid "Resend the code"
msgstr "Ipadala ulit ang code"

#: recruitment/templates/recruitment/applicant_otp.html
