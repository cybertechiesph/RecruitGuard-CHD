#: recruitment/templates/recruitment/applicant_otp.html
msgid "Check your <strong>Spam</strong> or <strong>Junk Mail</strong> folder."
msgstr "I-check ang <strong>Spam</strong> o <strong>Junk Mail</strong> folder mo."

#: recruitment/templates/recruitment/applicant_otp.html
msgid "Make sure the email address above is correct."
msgstr "Siguraduhing tama ang email sa itaas."

#: recruitment/templates/recruitment/applicant_otp.html
msgid "Email me a code"
msgstr "I-email sa akin ang code"

#: recruitment/templates/recruitment/applicant_otp.html
msgid "Wrong email address?"
msgstr "Mali ang email?"

#: recruitment/templates/recruitment/applicant_otp.html
msgid "Start again with the correct email"
msgstr "Ulitin gamit ang tamang email"

#: recruitment/templates/recruitment/applicant_otp.html
msgid "Return to job openings"
msgstr "Bumalik sa job openings"

#: recruitment/templates/recruitment/applicant_otp.html recruitment/templates/recruitment/applicant_status_lookup.html
msgid "See all my applications"
msgstr "Tingnan lahat ng application ko"

#: recruitment/templates/recruitment/applicant_otp.html recruitment/forms.py
msgid "Enter the 6-digit code from your email."
msgstr "Ilagay ang 6-digit code mula sa email mo."

#: recruitment/templates/recruitment/applicant_otp.html
