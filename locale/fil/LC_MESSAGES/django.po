msgstr "I-verify ang email mo"

#: recruitment/templates/recruitment/applicant_otp.html
msgid "Enter the code we emailed you to continue your application. Anything you already added is saved."
msgstr "Ilagay ang code na in-email namin para ituloy ang application mo. Naka-save ang lahat ng nailagay mo na."

#: recruitment/templates/recruitment/applicant_otp.html
msgid "Enter the code we emailed you. Then you can add your documents."
msgstr "Ilagay ang code na in-email namin. Pagkatapos, puwede mo nang idagdag ang documents mo."

#: recruitment/templates/recruitment/applicant_otp.html
msgid "To open your saved application, get a new code below &mdash; we&rsquo;ll send it to your email."
msgstr "Para mabuksan ang naka-save mong application, humingi ng bagong code sa baba &mdash; ipapadala namin ito sa email mo."

#: recruitment/templates/recruitment/applicant_otp.html
msgid "We sent a 6-digit code to:"
msgstr "Nagpadala kami ng 6-digit code sa:"

#: recruitment/templates/recruitment/applicant_otp.html
msgid "Your email:"
