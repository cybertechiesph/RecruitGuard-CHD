msgstr "Mag-apply ng Trabaho sa <br>DOH&ndash;CHD CALABARZON"

#: recruitment/templates/recruitment/applicant_portal.html
msgid "Browse current job openings, submit your application online, and track your status &mdash; all in one secure place."
msgstr "Tingnan ang mga bakanteng trabaho, mag-apply online, at alamin ang status ng iyong aplikasyon &mdash; lahat sa iisang ligtas na lugar."

#: recruitment/templates/recruitment/applicant_portal.html
msgid "Browse Openings"
msgstr "Tingnan ang mga Bakante"

#: recruitment/templates/recruitment/applicant_portal.html
msgid "How it works"
msgstr "Paano ito gumagana"

#: recruitment/templates/recruitment/applicant_portal.html
msgid "Browse openings"
msgstr "Tingnan ang mga bakante"

#: recruitment/templates/recruitment/applicant_portal.html
msgid "Find a position that fits you."
msgstr "Humanap ng trabahong bagay sa iyo."

#: recruitment/templates/recruitment/applicant_portal.html
msgid "Apply online"
msgstr "Mag-apply online"

#: recruitment/templates/recruitment/applicant_portal.html
msgid "Verify your email, then add your documents &mdash; phone photos are fine. Finish later if you need to."
msgstr "I-verify ang iyong email, saka idagdag ang iyong mga dokumento &mdash; puwede ang litrato mula sa phone. Puwede mo itong tapusin mamaya."

#: recruitment/templates/recruitment/applicant_portal.html
msgid "Track your application"
msgstr "I-track ang iyong aplikasyon"

#: recruitment/templates/recruitment/applicant_portal.html
msgid "Check your status anytime with the tracking code we give you when you submit."
msgstr "Alamin ang iyong status anumang oras gamit ang tracking code na ibibigay namin pagkasumite mo."

#: recruitment/templates/recruitment/applicant_portal.html
