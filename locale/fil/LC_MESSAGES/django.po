#: recruitment/templates/recruitment/applicant_receipt.html
msgid "Your Application Has Been Submitted"
msgstr "Naisumite na ang Iyong Aplikasyon"

#: recruitment/templates/recruitment/applicant_receipt.html
msgid "Thank you for applying. Your application has been received by DOH&ndash;CHD CALABARZON."
msgstr "Salamat sa pag-apply. Natanggap na ng DOH&ndash;CHD CALABARZON ang iyong aplikasyon."

#: recruitment/templates/recruitment/applicant_receipt.html
