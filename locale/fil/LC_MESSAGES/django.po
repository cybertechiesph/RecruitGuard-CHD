msgstr "Isumite"

#: recruitment/templates/recruitment/applicant_application.html
msgid "Your file"
msgstr "Ang iyong file"

#: recruitment/templates/recruitment/applicant_application.html
msgid "Close preview"
msgstr "Isara ang preview"

#: recruitment/templates/recruitment/applicant_application.html
msgid "Is this the right document, and is the text easy to read?"
msgstr "Ito ba ang tamang dokumento, at madali bang basahin ang teksto?"

#: recruitment/templates/recruitment/applicant_application.html
msgid "Close"
msgstr "Isara"

