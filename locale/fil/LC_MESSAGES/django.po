msgstr "Na-save dati: <strong>%(name)s</strong>. Magdagdag lang ng bagong file sa ibaba kung gusto mo itong palitan."

#: recruitment/templates/recruitment/applicant_application.html
msgid "You sent this with your application for <strong>%(title)s</strong> (%(date)s):"
msgstr "Ipinadala mo ito kasama ng aplikasyon mo para sa <strong>%(title)s</strong> (%(date)s):"

#: recruitment/templates/recruitment/applicant_application.html recruitment/portal_views.py
msgid "Use this file"
msgstr "Gamitin ang file na ito"

#: recruitment/templates/recruitment/applicant_application.html
msgid "Check it&rsquo;s still current (e.g. the PDS form version)."
msgstr "Siguraduhing updated pa ito (halimbawa, ang bersyon ng PDS form)."

#: recruitment/templates/recruitment/applicant_application.html recruitment/portal_views.py
msgid "Add another file"
msgstr "Magdagdag ng isa pang file"

#: recruitment/templates/recruitment/applicant_application.html recruitment/portal_views.py
msgid "Add files"
msgstr "Magdagdag ng mga file"

#: recruitment/templates/recruitment/applicant_application.html
msgid "Take a photo"
msgstr "Kumuha ng litrato"

#: recruitment/templates/recruitment/applicant_application.html
msgid "4. Submit your application"
msgstr "4. Isumite ang iyong aplikasyon"

#: recruitment/templates/recruitment/applicant_application.html
msgid "Still needed before you can submit:"
msgstr "Kailangan pa bago ka makapagsumite:"

#: recruitment/templates/recruitment/applicant_application.html
msgid "After you submit, you can no longer change your application. You&rsquo;ll get a receipt and a tracking code right away."
msgstr "Kapag naisumite mo na, hindi mo na mababago ang iyong aplikasyon. Makakatanggap ka agad ng resibo at tracking code."

