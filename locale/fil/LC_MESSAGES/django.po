msgid "Ready"
msgstr "Handa na"

#: recruitment/templates/recruitment/applicant_application.html recruitment/portal_views.py recruitment/requirements.py
msgid "Required"
msgstr "Kailangan"

#: recruitment/templates/recruitment/applicant_application.html recruitment/portal_views.py recruitment/requirements.py
msgid "If applicable"
msgstr "Kung naaangkop"

#: recruitment/templates/recruitment/applicant_application.html
