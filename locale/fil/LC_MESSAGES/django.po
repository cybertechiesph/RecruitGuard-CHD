msgstr "Naipadala na sa recruitment office ang iyong kahilingang mag-withdraw. Makakatanggap ka ng email kapag naitala na ito."

#: recruitment/portal_views.py
msgid "There are no documents awaiting resubmission for this application."
msgstr "Walang dokumentong naghihintay na maipadala ulit para sa aplikasyong ito."

#: recruitment/portal_views.py
msgid "We could not start your application right now. Please try again in a few moments."
msgstr "Hindi namin masimulan ang iyong aplikasyon ngayon. Pakisubukan ulit maya-maya."

#: recruitment/portal_views.py
msgid "We could not send the verification code right now. Use Resend the code in a few moments."
msgstr "Hindi namin maipadala ang verification code ngayon. Gamitin ang Ipadala ulit ang code maya-maya."

#: recruitment/portal_views.py
msgid "Choose a file to upload."
msgstr "Pumili ng file na ia-upload."

#: recruitment/portal_views.py
msgid "We could not send a verification code right now. Please try again in a few moments."
msgstr "Hindi kami makapagpadala ng verification code ngayon. Pakisubukan ulit maya-maya."

#: recruitment/portal_views.py
msgid "Your application for %(title)s is not finished yet. Verify your email to continue, or use Resend the code if the code expired."
msgstr "Hindi pa tapos ang iyong aplikasyon para sa %(title)s. I-verify ang iyong email para magpatuloy, o gamitin ang Ipadala ulit ang code kung nag-expire na ang code."

#: recruitment/portal_views.py
msgid "A verification code has been sent to your email address."
msgstr "Nagpadala kami ng verification code sa iyong email address."

#: recruitment/portal_views.py
msgid "Verify your email before resubmitting your documents."
msgstr "I-verify ang iyong email bago ipadala ulit ang iyong mga dokumento."

#: recruitment/portal_views.py
msgid "Your documents have been resubmitted for review."
msgstr "Naipadala na ulit ang iyong mga dokumento para marepaso."

#: recruitment/portal_views.py
msgid "Where: %(place)s"
msgstr "Saan: %(place)s"

#: recruitment/portal_views.py
msgid "Result: %(status)s"
msgstr "Resulta: %(status)s"

#: recruitment/portal_views.py
msgid "Final decision"
msgstr "Pinal na desisyon"

#: recruitment/portal_views.py
msgid "Your application is with the office for the final decision."
msgstr "Nasa opisina na ang iyong aplikasyon para sa pinal na desisyon."

#: recruitment/portal_views.py
msgid "This application could not be found."
msgstr "Hindi mahanap ang aplikasyong ito."

#: recruitment/portal_views.py
msgid "This application was already submitted."
msgstr "Naisumite na ang aplikasyong ito."

#: recruitment/portal_views.py
msgid "Your session ended. Reload the page and verify your email to continue."
msgstr "Natapos ang iyong session. I-reload ang page at i-verify ang iyong email para magpatuloy."

#: recruitment/portal_views.py
msgid "Choose a document to reuse."
msgstr "Pumili ng dokumentong gagamitin ulit."

#: recruitment/portal_views.py
msgid "We could not prepare a new verification code right now. Please try again in a few moments."
msgstr "Hindi kami makapaghanda ng bagong verification code ngayon. Pakisubukan ulit maya-maya."

#: recruitment/portal_views.py
msgid "Email verified. You can now re-upload the requested documents."
msgstr "Na-verify na ang email. Puwede mo nang i-upload ulit ang mga hinihinging dokumento."

#: recruitment/requirements.py
msgid "Upload the signed cover letter for this application."
msgstr "I-upload ang pirmadong cover letter para sa aplikasyong ito."

#: recruitment/requirements.py
msgid "Upload the completed Personal Data Sheet with the required photo attached."
msgstr "I-upload ang kumpletong Personal Data Sheet na may kalakip na kinakailangang litrato."

#: recruitment/requirements.py
msgid "Upload the Work Experience Sheet that accompanies the Personal Data Sheet."
msgstr "I-upload ang Work Experience Sheet na kasama ng Personal Data Sheet."

#: recruitment/requirements.py
msgid "Upload your latest performance rating only when you have an applicable rating for the last rating period."
msgstr "I-upload lang ang pinakabago mong performance rating kung mayroon kang naaangkop na rating para sa huling rating period."

#: recruitment/requirements.py
msgid "Upload the eligibility, rating, or license document relevant to this application."
msgstr "I-upload ang dokumento ng eligibility, rating, o lisensya na may kaugnayan sa aplikasyong ito."

#: recruitment/requirements.py
msgid "Upload the authenticated Transcript of Records."
msgstr "I-upload ang authenticated na Transcript of Records."

#: recruitment/requirements.py
msgid "Upload a copy of your diploma."
msgstr "Mag-upload ng kopya ng iyong diploma."

#: recruitment/requirements.py
msgid "Upload your certificate or certificates of employment."
msgstr "I-upload ang iyong certificate (o mga certificate) of employment."

#: recruitment/requirements.py
msgid "Upload your certificate or certificates for completed training courses."
msgstr "I-upload ang iyong certificate (o mga certificate) ng mga natapos na training."

#: recruitment/requirements.py
msgid "Upload the signed application letter for this COS application."
msgstr "I-upload ang pirmadong application letter para sa COS application na ito."

#: recruitment/requirements.py
msgid "Upload the eligibility, rating, or license document required for this COS application."
msgstr "I-upload ang dokumento ng eligibility, rating, o lisensya na kailangan para sa COS application na ito."

#: recruitment/requirements.py
msgid "Upload a copy of your Transcript of Records."
msgstr "Mag-upload ng kopya ng iyong Transcript of Records."

#: recruitment/requirements.py
msgid "Upload your training certificates when they apply to this COS application."
msgstr "I-upload ang iyong mga training certificate kung naaangkop sa COS application na ito."

#: recruitment/services.py
msgid "Too many invalid verification attempts. Request a new code."
msgstr "Masyadong maraming maling verification code. Humingi ng bagong code."

#: recruitment/services.py
msgid "You already asked to withdraw this application. The office will confirm by email."
msgstr "Humiling ka na ng pag-withdraw sa aplikasyong ito. Kukumpirmahin ito ng opisina sa pamamagitan ng email."

#: recruitment/services.py
msgid "This application can no longer be withdrawn online. Please contact the recruitment office."
msgstr "Hindi na maaaring i-withdraw online ang aplikasyong ito. Pakikontak ang recruitment office."

#: recruitment/services.py
msgid "This application was already submitted, so it can no longer be verified."
msgstr "Naisumite na ang aplikasyong ito, kaya hindi na ito mave-verify."

#: recruitment/services.py
msgid "Request a verification code first."
msgstr "Humingi muna ng verification code."

#: recruitment/services.py
msgid "The verification code has expired. Request a new code."
msgstr "Nag-expire na ang verification code. Humingi ng bagong code."

#: recruitment/services.py
msgid "The selected recruitment entry is not currently open for intake."
msgstr "Hindi na tumatanggap ng aplikasyon ang posisyong ito."

#: recruitment/services.py
msgid "This application can no longer be submitted."
msgstr "Hindi na maisusumite ang aplikasyong ito."

#: recruitment/services.py
msgid "Tick the confirmation box before you submit."
msgstr "I-tick ang confirmation box bago magsumite."

#: recruitment/services.py
msgid "Some documents use the same file. Use a different file for each document, then submit."
msgstr "May mga dokumentong pareho ang file. Gumamit ng ibang file para sa bawat dokumento, saka isumite."

#: recruitment/services.py
msgid "Only the applicant may resubmit documents for this application."
msgstr "Ang aplikante lang ang puwedeng magpadala ulit ng mga dokumento para sa aplikasyong ito."

#: recruitment/services.py
msgid "This application is not awaiting a document resubmission."
msgstr "Hindi naghihintay ng ipapadalang dokumento ang aplikasyong ito."

#: recruitment/services.py
msgid "There are no documents awaiting resubmission."
msgstr "Walang dokumentong naghihintay na maipadala ulit."

#: recruitment/services.py
msgid "The resubmission deadline has passed; please contact the recruitment team."
msgstr "Lumipas na ang deadline ng pagpapadala ulit; pakikontak ang recruitment team."

#: recruitment/services.py
msgid "Verify your email with a fresh code before resubmitting your documents."
msgstr "I-verify ang iyong email gamit ang bagong code bago ipadala ulit ang iyong mga dokumento."

#: recruitment/services.py
msgid "Upload a file for each flagged document before resubmitting."
msgstr "Mag-upload ng file para sa bawat minarkahang dokumento bago ipadala ulit."

#: recruitment/services.py
msgid "Your application draft and uploaded files were saved, but we could not send the verification code right now. Please try again in a few moments."
msgstr "Na-save ang iyong draft at mga in-upload na file, pero hindi namin maipadala ang verification code ngayon. Pakisubukan ulit maya-maya."

#: recruitment/services.py
msgid "A verification code can only be issued while the application is in draft or awaiting the applicant's resubmission."
msgstr "Makakapagpadala lang ng verification code habang draft pa ang aplikasyon o habang hinihintay ang ipapadala ulit na dokumento ng aplikante."

#: recruitment/services.py
msgid "This application has not been submitted yet."
msgstr "Hindi pa naisusumite ang aplikasyong ito."

#: recruitment/services.py
msgid "The verification code is invalid. You have %(count)s try left."
msgid_plural "The verification code is invalid. You have %(count)s tries left."
msgstr[0] "Mali ang verification code. May %(count)s subok ka pa."
msgstr[1] "Mali ang verification code. May %(count)s subok ka pa."

#: recruitment/services.py
msgid "An application for this recruitment entry already exists for this applicant."
msgstr "Mayroon nang aplikasyon ang aplikanteng ito para sa recruitment na ito."

#: recruitment/services.py
msgid "Add all required documents before you submit. %(count)s required document is still missing."
msgid_plural "Add all required documents before you submit. %(count)s required documents are still missing."
msgstr[0] "Idagdag ang lahat ng kailangang dokumento bago magsumite. %(count)s kailangang dokumento ang kulang pa."
msgstr[1] "Idagdag ang lahat ng kailangang dokumento bago magsumite. %(count)s kailangang dokumento ang kulang pa."

#: recruitment/services.py
msgid "Verify your email before you submit."
msgstr "I-verify ang iyong email bago magsumite."

#: recruitment/services.py
msgid "Please wait %(seconds)s seconds before requesting another code."
msgstr "Pakihintay ng %(seconds)s segundo bago humingi ng panibagong code."

#: recruitment/services.py
msgid "Your email verification has expired. Request a new code, then submit."
msgstr "Nag-expire na ang verification ng iyong email. Humingi ng bagong code, saka magsumite."

#: recruitment/upload_validation.py
msgid "This file is too large. Choose a file that is 5 MB or smaller."
msgstr "Masyadong malaki ang file na ito. Pumili ng file na 5 MB o mas maliit."

#: recruitment/upload_validation.py
msgid "This file is empty. Pick a file that has something in it."
msgstr "Walang laman ang file na ito. Pumili ng file na may laman."

#: recruitment/upload_validation.py
msgid "This needs to be a PDF, JPG, or PNG file. Upload one of those."
msgstr "Kailangang PDF, JPG, o PNG file ito. Mag-upload ng isa sa mga iyon."

#: recruitment/upload_validation.py
msgid "We couldn't read this as a PDF, JPG, or PNG. Save it again, then upload it."
msgstr "Hindi namin ito mabasa bilang PDF, JPG, o PNG. I-save ito ulit, saka i-upload."

#: recruitment/upload_validation.py
msgid "This file's contents don't match a PDF, JPG, or PNG. Save it again, then upload it."
msgstr "Hindi tugma ang laman ng file na ito sa PDF, JPG, o PNG. I-save ito ulit, saka i-upload."

#: recruitment/upload_validation.py
msgid "This file format does not match its filename. Save it again as a PDF, JPG, or PNG, then upload it."
msgstr "Hindi tugma ang format ng file na ito sa pangalan nito. I-save ito ulit bilang PDF, JPG, o PNG, saka i-upload."
