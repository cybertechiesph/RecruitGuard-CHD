msgid "How to Apply"
msgstr "Paano Mag-apply"

#: recruitment/templates/recruitment/applicant_vacancy_detail.html
msgid "Click <strong>&ldquo;Apply for This Position&rdquo;</strong> below and enter your name, email and mobile number."
msgstr "I-click ang <strong>&ldquo;Mag-apply sa Posisyong Ito&rdquo;</strong> sa ibaba at ilagay ang iyong pangalan, email at mobile number."

