msgstr[0] "Valid ang bawat code nang %(minutes)s minuto. Kapag nag-expire, humingi ng bago sa baba."
msgstr[1] "Valid ang bawat code nang %(minutes)s minuto. Kapag nag-expire, humingi ng bago sa baba."

#: recruitment/templates/recruitment/applicant_otp.html
msgid "Verify and continue"
msgstr "I-verify at ituloy"

#: recruitment/templates/recruitment/applicant_otp.html
msgid "Didn&rsquo;t receive the code?"
msgstr "Hindi mo natanggap ang code?"

#: recruitment/templates/recruitment/applicant_otp.html
