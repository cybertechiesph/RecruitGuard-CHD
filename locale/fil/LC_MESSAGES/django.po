msgstr "Human Resource Management Unit (HRMU)"

#: recruitment/templates/recruitment/applicant_portal.html
msgid "General questions:"
msgstr "Pangkalahatang tanong:"

#: recruitment/templates/recruitment/applicant_portal.html
msgid "Public Assistance Desk"
