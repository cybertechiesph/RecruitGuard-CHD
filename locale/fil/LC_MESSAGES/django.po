#: recruitment/templates/recruitment/applicant_my_applications.html recruitment/templates/recruitment/applicant_receipt.html recruitment/templates/recruitment/applicant_status_lookup.html recruitment/templates/recruitment/applicant_vacancy_detail.html
msgid "Back to Job Openings"
