msgstr "Walang posisyong tugma sa “{query}”. I-clear ang hinahanap para makita ang lahat ng bakante."

#: recruitment/templates/recruitment/applicant_portal.html
msgid "No positions match the selected filter."
msgstr "Walang posisyong tugma sa napiling filter."

